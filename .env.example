# Copy to .env and adjust. Every setting in src/rbirag/config.py can be set here
# with the RBIRAG_ prefix.

# --- paths
RBIRAG_RAW_DIR=data/raw
RBIRAG_PROCESSED_DIR=data/processed
RBIRAG_INDEX_DIR=indexes

# --- crawler (be polite: >= 1 s between requests)
RBIRAG_FETCH_START_ID=13050
RBIRAG_FETCH_MIN_ID=9000
RBIRAG_FETCH_MAX_DOCS=2200
RBIRAG_FETCH_RATE_LIMIT_SECONDS=1.5
RBIRAG_FETCH_PDFS=true

# --- chunking: fixed | semantic | section ; tokenizer: regex | whitespace | tiktoken
RBIRAG_CHUNKER=section
RBIRAG_TOKENIZER=regex
RBIRAG_CHUNK_SIZE=512
RBIRAG_CHUNK_OVERLAP=64

# --- models: embedder sentence-transformers | fake ; reranker cross-encoder | fake | none
RBIRAG_EMBEDDER=sentence-transformers
RBIRAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RBIRAG_RERANKER=cross-encoder
RBIRAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- qdrant: set a URL for a server, a path for embedded on-disk mode, or neither for in-memory
# RBIRAG_QDRANT_URL=http://localhost:6333
RBIRAG_QDRANT_PATH=indexes/qdrant
RBIRAG_QDRANT_COLLECTION=rbi_chunks

# --- retrieval: bm25 | dense | hybrid | hybrid_rerank
RBIRAG_RETRIEVAL_MODE=hybrid_rerank
RBIRAG_TOP_K=5
RBIRAG_RRF_K=60
RBIRAG_CONFIDENCE_THRESHOLD=0.5

# --- generation: openai_compatible (Gemini free tier by default) | anthropic | ollama | fake
RBIRAG_LLM_BACKEND=openai_compatible
RBIRAG_OAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
RBIRAG_OAI_API_KEY_ENV=GEMINI_API_KEY      # the *name* of the env var holding the key
RBIRAG_OAI_MODEL=gemini-2.5-flash-lite
# GEMINI_API_KEY=...                        # never commit a real key
# Groq:       RBIRAG_OAI_BASE_URL=https://api.groq.com/openai/v1/   RBIRAG_OAI_API_KEY_ENV=GROQ_API_KEY
# OpenRouter: RBIRAG_OAI_BASE_URL=https://openrouter.ai/api/v1/     RBIRAG_OAI_API_KEY_ENV=OPENROUTER_API_KEY

# free-tier hygiene: client-side limits per model, retries, and an on-disk response cache
RBIRAG_LLM_RPM=10
RBIRAG_LLM_RPD=200
RBIRAG_LLM_CACHE_DIR=.cache/llm

# local model
RBIRAG_OLLAMA_URL=http://localhost:11434
RBIRAG_OLLAMA_MODEL=qwen2.5:3b-instruct

# optional Anthropic backend (only used when selected and ANTHROPIC_API_KEY is set)
RBIRAG_ANTHROPIC_MODEL=claude-haiku-5-5

# --- evaluation
RBIRAG_QA_MODEL=gemini-2.5-flash
RBIRAG_JUDGE_MODEL=gemini-2.5-flash
RBIRAG_NLI_MODEL=cross-encoder/nli-deberta-v3-base
