# Copy to .env and adjust. Every setting in src/rbirag/config.py can be set here
# with the RBIRAG_ prefix.

# --- paths
RBIRAG_RAW_DIR=data/raw
RBIRAG_PROCESSED_DIR=data/processed
RBIRAG_INDEX_DIR=indexes

# --- crawler (be polite: >= 1 s between requests)
RBIRAG_FETCH_START_ID=13050
RBIRAG_FETCH_MIN_ID=9000
RBIRAG_FETCH_MAX_DOCS=2200
RBIRAG_FETCH_RATE_LIMIT_SECONDS=1.5
RBIRAG_FETCH_PDFS=true

# --- chunking: fixed | semantic | section ; tokenizer: regex | whitespace | tiktoken
RBIRAG_CHUNKER=section
RBIRAG_TOKENIZER=regex
RBIRAG_CHUNK_SIZE=512
RBIRAG_CHUNK_OVERLAP=64

# --- models: embedder sentence-transformers | fake ; reranker cross-encoder | fake | none
RBIRAG_EMBEDDER=sentence-transformers
RBIRAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RBIRAG_RERANKER=cross-encoder
RBIRAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- qdrant: set a URL for a server, a path for embedded on-disk mode, or neither for in-memory
# RBIRAG_QDRANT_URL=http://localhost:6333
RBIRAG_QDRANT_PATH=indexes/qdrant
RBIRAG_QDRANT_COLLECTION=rbi_chunks

# --- retrieval: bm25 | dense | hybrid | hybrid_rerank
RBIRAG_RETRIEVAL_MODE=hybrid_rerank
RBIRAG_TOP_K=5
RBIRAG_RRF_K=60
RBIRAG_CONFIDENCE_THRESHOLD=0.5

# --- generation: openai_compatible | anthropic | ollama | fake
RBIRAG_LLM_BACKEND=openai_compatible
# provider presets: groq (default) | gemini | custom. Empty values = the preset's.
RBIRAG_LLM_PROVIDER=groq
# GROQ_API_KEY=...                          # never commit a real key
# GEMINI_API_KEY=...                        # only for RBIRAG_LLM_PROVIDER=gemini
# Generator chain (Groq preset: openai/gpt-oss-20b, then qwen/qwen3.8-27b)
# RBIRAG_OAI_MODEL=openai/gpt-oss-20b
# RBIRAG_OAI_MODEL_FALLBACKS=qwen/qwen3.8-27b
# Custom provider example (OpenRouter):
# RBIRAG_LLM_PROVIDER=custom
# RBIRAG_OAI_BASE_URL=https://openrouter.ai/api/v1
# RBIRAG_OAI_API_KEY_ENV=OPENROUTER_API_KEY
# RBIRAG_OAI_MODEL=... RBIRAG_QA_MODEL=... RBIRAG_JUDGE_MODEL=...

# free-tier hygiene: client-side limits per model (0 = provider preset), retries,
# fallbacks after repeated 503s, and an on-disk cache of successful responses
RBIRAG_LLM_RPM=0
RBIRAG_LLM_RPD=0
RBIRAG_LLM_TPM=0
RBIRAG_LLM_SWITCH_AFTER_503=2
RBIRAG_LLM_MODEL_COOLDOWN_SECONDS=300
RBIRAG_LLM_CACHE_DIR=.cache/llm

# local model
RBIRAG_OLLAMA_URL=http://localhost:11434
RBIRAG_OLLAMA_MODEL=qwen2.5:3b-instruct

# optional Anthropic backend (only used when selected and ANTHROPIC_API_KEY is set)
RBIRAG_ANTHROPIC_MODEL=claude-haiku-5-5

# --- evaluation (Groq preset: judge and Q/A writer openai/gpt-oss-120b, then
# qwen/qwen3.8-27b)
# RBIRAG_QA_MODEL=openai/gpt-oss-120b
# RBIRAG_QA_MODEL_FALLBACKS=qwen/qwen3.8-27b
# RBIRAG_JUDGE_MODEL=openai/gpt-oss-120b
# RBIRAG_JUDGE_MODEL_FALLBACKS=qwen/qwen3.8-27b
RBIRAG_NLI_MODEL=cross-encoder/nli-deberta-v3-base

# --- API / UI / Docker
RBIRAG_API_PORT=8000
# RBIRAG_REQUEST_LOG_PATH=logs/requests.jsonl   # mirror the request log for /metrics
# RBIRAG_QDRANT_URL=http://qdrant:6333          # set by docker-compose for the api service
# RBIRAG_API_URL=http://localhost:8000          # used by the Streamlit UI
# RBIRAG_BOOTSTRAP_FIXTURES=1                   # docker: build a tiny fixture index on start
